# Ignore source control and GitHub specific files
.git/
.github/

# Ignore local WRATH index and environment files
.wrath/
.env
.env.*

# Ignore testing files
test/
tests/
__tests__/
*.test.js
*.spec.js
coverage/
.nyc_output/

